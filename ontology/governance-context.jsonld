{
  "@context": {
    "ec": {"@id": "https://id.exergism.org/commons#", "@prefix": true},
    "ecg": {"@id": "https://id.exergism.org/governance#", "@prefix": true},
    "xsd": {"@id": "http://www.w3.org/2001/XMLSchema#", "@prefix": true},
    "id": "@id",
    "type": "@type",

    "stableId": "ec:stableId",
    "title": "ec:title",
    "status": "ec:status",
    "rationale": "ec:rationale",
    "operative": {"@id": "ec:operative", "@type": "xsd:boolean"},
    "effectiveDate": {"@id": "ec:effectiveDate", "@type": "xsd:dateTime"},
    "provenance": "ec:provenance",
    "sha256": "ec:sha256",
    "reviewDue": {"@id": "ec:reviewDue", "@type": "xsd:date"},
    "supersedes": {"@id": "ec:supersedes", "@type": "@id"},

    "GovernanceRule": "ecg:GovernanceRule",
    "GovernanceRecord": "ecg:GovernanceRecord",
    "GovernanceDecision": "ecg:GovernanceDecision",
    "DecisionClass": "ecg:DecisionClass",
    "Vote": "ecg:Vote",
    "ConflictDeclaration": "ecg:ConflictDeclaration",
    "Delegation": "ecg:Delegation",
    "Role": "ecg:Role",
    "Member": "ecg:Member",
    "MembershipRecord": "ecg:MembershipRecord",

    "decisionClass": {"@id": "ecg:decisionClass", "@type": "@id"},
    "authorizedBy": {"@id": "ecg:authorizedBy", "@type": "@id"},
    "requiresApprovalClass": {"@id": "ecg:requiresApprovalClass", "@type": "@id"},
    "delegatedTo": {"@id": "ecg:delegatedTo", "@type": "@id"},
    "delegatedRole": {"@id": "ecg:delegatedRole", "@type": "@id"},
    "hasConflictDeclaration": {"@id": "ecg:hasConflictDeclaration", "@type": "@id"},
    "interestedParty": {"@id": "ecg:interestedParty", "@type": "@id"},
    "hasVote": {"@id": "ecg:hasVote", "@type": "@id", "@container": "@set"},
    "voter": {"@id": "ecg:voter", "@type": "@id"},
    "membershipSubject": {"@id": "ecg:membershipSubject", "@type": "@id"},
    "foundingPhase": {"@id": "ecg:foundingPhase", "@type": "@id"},
    "missionGuardian": {"@id": "ecg:missionGuardian", "@type": "@id"},

    "governanceVersion": "ecg:governanceVersion",
    "decisionId": "ecg:decisionId",
    "memberRecordId": "ecg:memberRecordId",
    "decisionDate": {"@id": "ecg:decisionDate", "@type": "xsd:date"},
    "voteValue": "ecg:voteValue",
    "votingEligibleFrom": {"@id": "ecg:votingEligibleFrom", "@type": "xsd:dateTime"},
    "quorumEligible": {"@id": "ecg:quorumEligible", "@type": "xsd:nonNegativeInteger"},
    "votesFor": {"@id": "ecg:votesFor", "@type": "xsd:nonNegativeInteger"},
    "votesAgainst": {"@id": "ecg:votesAgainst", "@type": "xsd:nonNegativeInteger"},
    "abstentions": {"@id": "ecg:abstentions", "@type": "xsd:nonNegativeInteger"},
    "recused": {"@id": "ecg:recused", "@type": "xsd:nonNegativeInteger"},
    "missionVetoExercised": {"@id": "ecg:missionVetoExercised", "@type": "xsd:boolean"}
  }
}
