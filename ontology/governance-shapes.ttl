@prefix ec: <https://id.exergism.org/commons#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Draft structural constraints. Legal/institutional validity remains external.

ec:GovernanceDecisionShape a sh:NodeShape ;
    sh:targetClass ec:GovernanceDecision ;
    sh:property [
        sh:path ec:decisionClass ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ec:operative ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path ec:governanceVersion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ec:DelegationShape a sh:NodeShape ;
    sh:targetClass ec:Delegation ;
    sh:or (
      [ sh:property [ sh:path ec:delegatedTo ; sh:minCount 1 ] ]
      [ sh:property [ sh:path ec:delegatedRole ; sh:minCount 1 ] ]
    ) .

ec:MembershipRecordShape a sh:NodeShape ;
    sh:targetClass ec:MembershipRecord ;
    sh:property [
        sh:path ec:memberRecordId ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ec:operative ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] .

# Policy-sensitive constraints such as exact threshold arithmetic, membership
# seasoning, bootstrap operativity, founder phase transitions, conflict-recusal
# arithmetic, Endowment principal withdrawal, Mission Lock and domain-transfer
# approval are additionally checked by deterministic code because their validity
# depends on versioned policy state rather than graph shape alone.
